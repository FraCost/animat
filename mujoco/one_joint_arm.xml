<mujoco model="one-joint-arm">

  <visual>
    <map force="0.1" zfar="30" />
    <rgba haze="0 0 0 1" />
    <global offwidth="1920" offheight="1080" elevation="-90" azimuth="0" />
    <quality shadowsize="2048" />
    <headlight ambient="0.3 0.3 0.3" diffuse="0.8 0.8 0.8" specular="0.4 0.4 0.4"/>
  </visual>

  <asset>
    <material name="arm_mat" rgba="0.8 0.7 0.6 1" specular="0.1" shininess="0.1" reflectance="0"/>
    <material name="tendon_mat" rgba="1 1 1 1" specular="0" shininess="0" reflectance="0" emission="0.2"/>
  </asset>

  <default>
    <joint damping="0.1" />
    <muscle ctrllimited="true" ctrlrange="0 1" />
    <geom material="arm_mat" />
    <tendon material="tendon_mat" />
  </default>

  <worldbody>
    <camera name="top" mode="fixed" pos="0 0 3.5" euler="0 0 0" fovy="30"/>

    <!-- TRUNK -->
    <body name="trunk" pos="0 0 0">
      <site name="muscle1_trunk" pos="0.1 0 0" size="0.01"/>
      <site name="muscle2_trunk" pos="-0.1 0 0" size="0.01"/>

      <!-- ARM -->
      <body name="arm" pos="0 0 0">
        <joint name="shoulder" type="hinge" axis="0 0 1" range="-60 60" />
        <geom name="arm_geom" type="cylinder" size="0.025" fromto="0 0 0 0 -0.5 0" />

        <!-- HAND -->
        <body name="hand" pos="0 -0.5 0">
          <geom name="hand" type="sphere" size="0.05" pos="0 0 0" rgba="1 .25 .25 1"/>
          <site name="muscle1_hand" pos="0 0 0"/>
          <site name="muscle2_hand" pos="0 0 0"/>
          <site name="nail" pos="0 0 0"/>
        </body>
      </body>
    </body>

    <!-- TARGET -->
    <body name="target" mocap="true" pos="0 0 0">
      <geom name="target" size=".025" type="sphere" contype="0" conaffinity="0" rgba="0 .75 1 1"/>
    </body>
  </worldbody>

  <tendon>
    <spatial name="muscle1_tendon" limited="true" range="0 1" width="0.008" rgba="1 0 0 1">
      <site site="muscle1_trunk"/>
      <site site="muscle1_hand"/>
    </spatial>

    <spatial name="muscle2_tendon" limited="true" range="0 1" width="0.008" rgba="0 1 0 1">
      <site site="muscle2_trunk"/>
      <site site="muscle2_hand"/>
    </spatial>
  </tendon>

  <actuator>
    <muscle name="muscle1" tendon="muscle1_tendon" ctrlrange="0 1" force="100" timeconst=".01 .04"/>
    <muscle name="muscle2" tendon="muscle2_tendon" ctrlrange="0 1" force="100" timeconst=".01 .04"/>
  </actuator>

  <sensor>
    <actuatorpos name="muscle1_length" actuator="muscle1"/>
    <actuatorpos name="muscle2_length" actuator="muscle2"/>
    <actuatorvel name="muscle1_velocity" actuator="muscle1"/>
    <actuatorvel name="muscle2_velocity" actuator="muscle2"/>
    <actuatorfrc name="muscle1_force" actuator="muscle1"/>
    <actuatorfrc name="muscle2_force" actuator="muscle2"/>
  </sensor>

</mujoco>
